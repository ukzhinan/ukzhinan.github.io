---
permalink: /feed.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ site.title }}</title>
    <link>{{ site.url }}/</link>
    <description>{{ site.description }}</description>
    <language>zh-CN</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <atom:link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/rss+xml"/>
    {% assign docs = site.chapters | sort: "weight" %}
    {% for doc in docs %}
    <item>
      <title>{{ doc.title | xml_escape }}</title>
      <link>{{ doc.url | absolute_url }}</link>
      <guid isPermaLink="true">{{ doc.url | absolute_url }}</guid>
      <description>{{ doc.description | default: site.description | xml_escape }}</description>
      {% if doc.updated %}<pubDate>{{ doc.updated | date_to_rfc822 }}</pubDate>{% endif %}
    </item>
    {% endfor %}
  </channel>
</rss>
