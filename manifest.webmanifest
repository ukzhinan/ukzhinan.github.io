---
permalink: /manifest.webmanifest
sitemap: false
---
{
  "name": "{{ site.title }}",
  "short_name": "英国手册",
  "description": "{{ site.description }}",
  "start_url": "{{ '/' | relative_url }}",
  "display": "standalone",
  "background_color": "#f7f7f4",
  "theme_color": "#012169",
  "icons": [
    { "src": "{{ '/assets/images/icon-192.png' | relative_url }}", "sizes": "192x192", "type": "image/png" },
    { "src": "{{ '/assets/images/icon-512.png' | relative_url }}", "sizes": "512x512", "type": "image/png" },
    { "src": "{{ '/assets/images/favicon.svg' | relative_url }}", "sizes": "any", "type": "image/svg+xml" }
  ]
}
